# --- pixi -------------------------------------------------------------------
# The environment itself is generated; pixi.lock is NOT ignored -- this is an
# application, so the lockfile is committed and CI installs with --locked.
.pixi/

# --- python -----------------------------------------------------------------
__pycache__/
*.py[cod]
*.egg-info/
dist/
build/

# --- test / tooling caches --------------------------------------------------
.coverage
.coverage.*
coverage.xml
htmlcov/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# --- model weights (INFRA-11) ----------------------------------------------
# Weights are never committed; they arrive only via `pixi run fetch-models`.
models/
*.onnx
*.pt
*.pth

# --- research datasets (EVAL-21, D-08) --------------------------------------
# Raw research data (CARPK, FSCD-*, RPINE) is large and licence-restricted; it is never
# committed and arrives only via `pixi run fetch-datasets`, which records SHA-256 + source
# URL + licence in datasets/provenance.json. The committed, diffable facts live OUTSIDE this
# tree: split manifests in dataset_splits/ and the offline test fixtures in tests/fixtures/.
# Leading slash anchors this to the REPO-ROOT datasets/ only, so the committed dataset_splits/
# manifests (kept out of conf/ so Hydra does not see a `datasets` config group) are untouched.
/datasets/

# --- local data stores ------------------------------------------------------
runs.db
runs.db-journal
runs.db-wal
runs.db-shm

# --- os ---------------------------------------------------------------------
.DS_Store

# --- scratch ----------------------------------------------------------------
.tmp-probe/
.scratch/

# --- benchmark output (EVAL-04) ---------------------------------------------
# results.json is a regenerable benchmark artifact (`pixi run bench` / `bench-ci`); the
# COMMITTED deliverable is the derived charts/tables (EVAL-06, plan 08-02), not this raw dump.
# The full run also depends on fetched weights, so the file's contents vary by environment.
docs/benchmark/results.json
# real-objects-results.json is the analogous raw dump from the real-objects-only sweep
# (`pixi run bench-real-objects`); same reasoning -- the committed deliverable is
# docs/reports/real-objects-report.html + real-objects-findings.md, not this raw dump.
docs/benchmark/real-objects-results.json
# research-results.json is the analogous raw dump from the research sweep (`pixi run bench-research`
# / run_research_sweep); it depends on the licence-gated fetched archives + weights, so its numbers
# vary by environment. The COMMITTED deliverable is docs/reports/research-report.* + the DOC-07 doc.
docs/benchmark/research-results.json
# Per-method domain threshold tuning dumps (`pixi run tune-floorplans`): same environment-dependent,
# licence/weights-gated raw numbers as research-results.json, so likewise never committed.
docs/benchmark/*-tuning-results.json
docs/benchmark/permethod/
# The local floor-plan report + its TP/FP/FN overlays EMBED the floor-plan images (licensed data),
# so they are read locally but never committed. The aggregate stat charts under docs/eval/img/ carry
# no plan pixels and ARE committed. (build via `pixi run python scripts/build_floorplans_report.py`)
docs/benchmark/floorplans-report.html
docs/benchmark/floorplans-overlays/
docs/benchmark/floorplans-results.md
# Hydra's job-logging sink (disabled in conf/benchmark.yaml, ignored as a belt-and-braces).
benchmark.log
# Raw per-experiment dumps + logs from the quick-task lab benches (e.g.
# scripts/ncc_floorplan_experiment.py, scripts/mosse_floorplan_experiment.py). Same rule as the
# tuning dumps above: they carry environment-dependent numbers and PER-IMAGE rows keyed to the
# licensed floor-plan images. The committed deliverable is the aggregate table in each task's
# EXPERIMENTS.md + the report section.
.planning/quick/*/runs/
.planning/quick/*/logs/
# Per-image debug renders from scripts/ncc_debug_visualize.py (and its future siblings) --
# derived from the licensed floor-plan images, not a committed deliverable in their own right.
.planning/quick/*/debug/

# MkDocs build output — regenerated by `pixi run docs-build` and published to GitHub Pages by
# CI (.github/workflows/docs.yml). Never committed; the docs/ Markdown is the source of truth.
site/

# Real-object-insertion set (EVAL): raw Commons downloads and cached FastSAM cutouts are
# regenerable (`pixi run fetch-real-photos` / `pixi run real-objects`) and depend on the
# gitignored FastSAM weight. Only the composited JPEGs + .gt.json sidecars under
# assets/demo/real-objects/ are committed.
assets/demo/real-objects/_raw/
assets/demo/real-objects/cutouts/

# Deliberately NOT ignored, do not add:
#   pixi.lock       -- committed on purpose (application, reproducible CI)
#   docs/assets/ui/ -- committed UI walkthrough screenshots (captured by scripts/capture_ui.py)
#   docs/samples/   -- pre-rendered sample runs are committed (DOC-02)
#   assets/demo/    -- demo images are committed (DOC-01)
